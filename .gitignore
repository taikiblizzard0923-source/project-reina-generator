config.yaml
output/*
downloads/
!output/.gitkeep
input/*
!input/.gitkeep
# presets/ の *.yaml は自分用の設定。*.example.yaml をコピーして使う。
# 名前は自由に付けられる（beach.yaml など）ので、example 以外は全部管理外にする。
# （Git 管理下のまま編集すると git pull のたびに衝突するため）
presets/*.yaml
!presets/*.example.yaml
__pycache__/
*.pyc
.venv/
*.gguf
*.safetensors
